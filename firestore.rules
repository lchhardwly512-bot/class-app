rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin()   { return signedIn() && role() == 'admin'; }
    function isTeacher() { return signedIn() && role() == 'teacher'; }
    function isStudent() { return signedIn() && role() == 'student'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher() || isAdmin());
      allow create: if isTeacher() && request.resource.data.role == 'student';
      allow update, delete: if isTeacher() && resource.data.role == 'student';
    }

    // دانش‌آموز فقط امتیازهای خودش را می‌بیند
    match /points/{id} {
      allow read: if isTeacher() || isAdmin()
                  || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, delete: if isTeacher();
    }

    match /attendance/{id} {
      allow read: if isTeacher() || isAdmin();
      allow write: if isTeacher();
    }

    match /grades/{id} {
      allow read: if isTeacher() || isAdmin();
      allow write: if isTeacher();
    }

    match /homework/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // علامت «انجام دادم» دانش‌آموز
    match /hwdone/{id} {
      allow read: if isTeacher() || isAdmin()
                  || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid
                    && id == request.resource.data.hwId + '_' + request.auth.uid;
      allow delete: if isStudent() && resource.data.studentId == request.auth.uid;
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
